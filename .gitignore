# Public repository uses an explicit allowlist. Local files remain untouched.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/semantic-overlay/
!/browser-extension/
/semantic-overlay/*
!/semantic-overlay/*.py
!/semantic-overlay/start.cmd
!/semantic-overlay/start.ps1
!/semantic-overlay/configure-key.cmd
!/semantic-overlay/configure-key.ps1
!/semantic-overlay/package.ps1
!/semantic-overlay/AGENTS.md
!/semantic-overlay/PRODUCT_SCOPE.md
!/semantic-overlay/METRICS.md
!/semantic-overlay/REAL_WORLD_TEST_PROTOCOL.md
!/semantic-overlay/native-host/
/semantic-overlay/native-host/*
!/semantic-overlay/native-host/*.cs
!/semantic-overlay/native-host/*.ps1
!/semantic-overlay/native-host/diagnostics/
/semantic-overlay/native-host/diagnostics/*
!/semantic-overlay/native-host/diagnostics/*.cs
!/semantic-overlay/native-host/diagnostics/*.ps1
!/semantic-overlay/installer/
/semantic-overlay/installer/*
!/semantic-overlay/installer/*.cs
!/semantic-overlay/installer/*.ps1
!/semantic-overlay/tests/
/semantic-overlay/tests/*
!/semantic-overlay/tests/test_*.py
!/semantic-overlay/tests/local_model_fixture.py
!/semantic-overlay/tests/*.cjs
!/semantic-overlay/vendor/
/semantic-overlay/vendor/*
!/semantic-overlay/vendor/NAudio/
/semantic-overlay/vendor/NAudio/*
!/semantic-overlay/vendor/NAudio/NAudio.dll
!/semantic-overlay/vendor/NAudio/LICENSE.txt
/browser-extension/*
!/browser-extension/*.js
!/browser-extension/*.css
!/browser-extension/*.html
!/browser-extension/manifest.json
!/browser-extension/AGENTS.md
